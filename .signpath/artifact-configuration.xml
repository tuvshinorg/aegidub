<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the aegidub project. The release
     workflow sends aegidub.exe and then the installer, each zipped by
     actions/upload-artifact; this signs the .exe inside either. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
